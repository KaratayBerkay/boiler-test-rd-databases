# Copy to k8s/.env (chmod 600). Filled in / extended by k8s/harbor/up.sh on first run.
#
# Where Harbor answers. Must be an address that BOTH the host and the k3d nodes can reach, so it is the
# host's LAN IP by default (127.0.0.1 would point every k3s node at itself). Pushes from the host go through
# 127.0.0.1:${HARBOR_HTTPS_PORT} which Docker trusts without any daemon configuration; the k3s nodes trust the
# generated CA (harbor/certs/ca.crt, mounted into every node by k3d.yaml).
HARBOR_HOST=10.10.2.51
HARBOR_HTTP_PORT=8880
HARBOR_HTTPS_PORT=8443
HARBOR_ADMIN_PASSWORD=change-me
HARBOR_DB_PASSWORD=change-me
HARBOR_PROJECT=rdlab
# robot accounts (created by harbor/setup.py; secrets are shown once by Harbor and stored here). Single quotes: the
# names contain a literal $ that must not be expanded when the file is sourced.
HARBOR_PUSH_USER='robot$rdlab+pusher'
HARBOR_PUSH_PASSWORD=
HARBOR_PULL_USER='robot$rdlab+k3s'
HARBOR_PULL_PASSWORD=
# k3d cluster name (kubectl context becomes k3d-${CLUSTER})
CLUSTER=rdlab
