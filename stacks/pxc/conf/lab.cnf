[mysqld]
pxc_encrypt_cluster_traffic=OFF
pxc_strict_mode=PERMISSIVE
wsrep_slave_threads=8
wsrep_provider_options="gcache.size=512M;gcs.fc_limit=256"
innodb_buffer_pool_size=2G
max_connections=1000
local_infile=ON
performance_schema=ON
character_set_server=utf8mb4

# ---- logging strategy (each node writes its own files, named by hostname) ----
log_error=/var/log/mysql/error.log
log_error_verbosity=3
log_timestamps=SYSTEM
slow_query_log=ON
long_query_time=0.1
log_slow_extra=ON
log_slow_verbosity=full
log_slow_rate_limit=1
slow_query_log_file=/var/log/mysql/slow.log
general_log=OFF
general_log_file=/var/log/mysql/general.log
innodb_print_all_deadlocks=ON
# audit_log plugin (Percona): JSON records, DDL / account commands only ("loose-": the variables are unknown while --initialize runs without plugins)
plugin-load-add=audit_log=audit_log.so
loose-audit_log_format=JSON
loose-audit_log_file=/var/log/mysql/audit.json
loose-audit_log_policy=QUERIES
loose-audit_log_include_commands=create_table,drop_table,alter_table,create_db,drop_db,truncate,grant,revoke,create_user,drop_user,alter_user
loose-audit_log_rotate_on_size=100M
loose-audit_log_rotations=3
