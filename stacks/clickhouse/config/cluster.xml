<clickhouse>
    <listen_host>0.0.0.0</listen_host>
    <remote_servers>
        <lab_cluster>
            <shard>
                <internal_replication>true</internal_replication>
                <replica><host>ch1</host><port>9000</port><user>lab</user><password>labpass</password></replica>
                <replica><host>ch2</host><port>9000</port><user>lab</user><password>labpass</password></replica>
            </shard>
        </lab_cluster>
    </remote_servers>
    <zookeeper>
        <node><host>keeper</host><port>9181</port></node>
    </zookeeper>
    <distributed_ddl><path>/clickhouse/task_queue/ddl</path></distributed_ddl>
    <max_connections>4096</max_connections>
    <max_concurrent_queries>500</max_concurrent_queries>
</clickhouse>
